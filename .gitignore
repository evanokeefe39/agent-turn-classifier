.venv/
__pycache__/
*.py[cod]
.mypy_cache/
.ruff_cache/
.pytest_cache/
.env
.env.*
!.env.example
config.local.yaml

# Runtime-generated: everything the tool writes (records, turns, labels, models, bench, staging, stale)
.out/
models/
runs/

# User-owned inputs. Everything here is ignored EXCEPT the shipped examples, which are tracked.
user_data/*
!user_data/config.example.yaml
!user_data/ontology.overlay.example.yaml

tasks/plans/
tasks/lessons.md
*.parquet
*.onnx
*.joblib

# Session corpora are never committed. `examples/` is the single exception: the
# tracer's fixtures live there and MUST reach a clone, or the notebook fails on
# its first data cell. Ordering is load-bearing -- a `!` re-include cannot reach
# a file inside an ignored directory, so `*.jsonl` is matched with the directory
# walk intact rather than as an ignored `examples/` dir.
*.jsonl
!examples/*.jsonl
